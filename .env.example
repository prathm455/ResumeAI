# ============================================================
# ResumeAI Environment Variables
# COPY this file to backend/.env and fill in YOUR values.
# NEVER commit the actual .env file — it is in .gitignore.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=resumeai

# --- Session Secret (use a long random string) ---
SESSION_SECRET=change_this_to_a_long_random_secret_string

# --- ML Service (Phase 4) ---
ML_SERVICE_URL=http://127.0.0.1:8000
